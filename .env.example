APP_NAME=Macbeth AI Story Game
APP_ENV=development
API_PREFIX=/api/v1
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
GENERATION_MODEL=qwen3:4b
GENERATION_TEMPERATURE=0.7
GENERATION_MAX_TOKENS=768
GENERATION_CONTEXT_WINDOW=4096
NARRATIVE_MAX_PROMPT_CHARS=12000
OLLAMA_KEEP_ALIVE=5m
EMBEDDING_MODEL=nomic-embed-text
CONTENT_DIR=content/macbeth
DATA_DIR=data
SQLITE_PATH=data/macbeth.sqlite3
FAISS_INDEX_DIR=data/faiss
PDF_SOURCE_PATH=content/macbeth/source/macbeth_original.pdf
RAG_METADATA_PATH=data/faiss/metadata.json
RAG_CHUNKS_PATH=data/macbeth/chunks.json
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180
RAG_DEFAULT_TOP_K=4
NARRATIVE_RETRIEVAL_TOP_K=4
OLLAMA_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=32
RAG_SCANNED_PAGE_CHAR_THRESHOLD=40
