{
  "name": "macbeth-game-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "build": "npm run typecheck && vite build",
    "test": "vitest run --environment jsdom",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:e2e:headed": "node scripts/run-playwright.mjs --headed",
    "test:e2e:local": "node scripts/run-playwright.mjs --local",
    "test:e2e:report": "playwright show-report",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.12"
  }
}
